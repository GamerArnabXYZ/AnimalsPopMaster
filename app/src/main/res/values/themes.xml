<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AnimalsPop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <!-- Splash screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Game ka apna brand color (dialogs/buttons mein already use hota hai) -->
        <item name="windowSplashScreenBackground">@color/brown</item>
        <!-- Icon custom set nahi kiya -> launcher (fox adaptive icon) default use hoga -->
        <!-- Splash khatam hote hi ye theme apply hoga, MainActivity ka manual setTheme() hataya -->
        <item name="postSplashScreenTheme">@style/Theme.AnimalsPop</item>
    </style>
</resources>